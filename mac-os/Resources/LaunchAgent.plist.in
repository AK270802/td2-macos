<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: Scripts/embed-agent.sh fills __API_URL__ per build configuration
     and installs it at Contents/Library/LaunchAgents/. Registered at runtime via
     SMAppService.agent(plistName:) — never copied to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.baseel.effilens.mac.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/effilens-agentd</string>
	<key>ProgramArguments</key>
	<array>
		<string>effilens-agentd</string>
		<string>run</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.baseel.effilens.mac</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>WORKPULSE_API_URL</key>
		<string>__API_URL__</string>
	</dict>
</dict>
</plist>
