{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "EffiLens",
  "version": "2.0.0",
  "identifier": "com.baseel.workpulse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cargo build --release -p agentd && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EffiLens",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "currentUser",
        "installerHooks": "./installer/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["xdotool", "xprintidle"],
        "files": {
          "/usr/lib/systemd/user/workpulse-agentd.service": "./installer/linux/workpulse-agentd.service"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "shell": { "open": true },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRjE3QTYzOTU4RTcyMgpSV1FpNTFnNXBoZlBCU0M1a1NaQ09NRytHQkJxUDM2V2hqaWd5Rm5hTzNxdE9oMStJalpKeXE4TQo=",
      "endpoints": [
        "https://dev-workpulse-api.baseel.com/api/v1/agent/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
