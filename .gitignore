# Rust / Cargo
/target/
**/*.rs.bk

# Node / npm
node_modules/
app/node_modules/

# Tauri build output
app/src-tauri/target/
app/src-tauri/gen/

# agentd sidecar binaries (built per target-triple by prepare-agentd-sidecar.mjs / CI)
app/src-tauri/binaries/

# Vite / frontend build
app/dist/
app/dist-ssr/
*.local

# Environment / secrets
.env
.env.*
!.env.example

# Updater signing key — private half must never be committed. Generated
# once with `npx tauri signer generate`; the CI release pipeline injects it
# via TAURI_SIGNING_PRIVATE_KEY(_PASSWORD) secrets, not this file on disk.
app/src-tauri/keys/*.key

# OS artefacts
Thumbs.db
.DS_Store
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Installer output
installer/output/
installer/*.exe
installer/*.msi

# Logs
*.log
logs/

# SQLCipher / encrypted DB
*.db
*.db-shm
*.db-wal
